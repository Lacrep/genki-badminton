{
  "name": "genki-badminton",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ระบบจัดก๊วนแบดมินตัน Genki Desu Badminton Society",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild api/boot.ts --platform=node --bundle --packages=external --alias:@shared=./shared --format=esm --outdir=dist",
    "start": "node dist/boot.js",
    "check": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b",
    "serve": "npm run build && npm start",
    "demo": "node scripts/demo.mjs",
    "reset-sessions": "node scripts/reset-sessions.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "hono": "^4.8.3",
    "lucide-react": "^0.562.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.19.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  }
}

{
  "name": "genki-badminton",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "description": "ระบบจัดก๊วนแบดมินตัน Genki Desu Badminton Society",
  "scripts": {
    "dev": "node scripts/check-node.cjs && vite",
    "build": "node scripts/check-node.cjs && vite build && node scripts/build-server.mjs",
    "start": "node dist/boot.js",
    "check": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b",
    "serve": "npm start",
    "demo": "node scripts/demo.mjs",
    "reset-sessions": "node scripts/reset-sessions.mjs",
    "fetch-fonts": "node scripts/fetch-fonts.mjs public/fonts",
    "find-data": "node scripts/find-data.mjs",
    "use-data": "node scripts/use-data.mjs",
    "merge-data": "node scripts/merge-data.mjs",
    "save-data": "node scripts/save-data.mjs",
    "prestart": "npm run build",
    "keep-session": "node scripts/keep-session.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "hono": "^4.8.3",
    "lucide-react": "^0.562.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.19.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  }
}

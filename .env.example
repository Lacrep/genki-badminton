# Port the server listens on in production (npm run start)
PORT=3100

# Where the session/roster JSON files live (relative to the badminton/ folder)
DATA_DIR=./data

# Organizer PIN. Anyone with the link can watch the queue; only a device that
# has entered this PIN can move players, start and finish games.
# Leave empty to let every visitor control the session (fine for a private link).
ORGANIZER_PIN=

# ── GIT_AUTOSYNC — เฉพาะตอนรันบนโฮสต์ที่ดิสก์ไม่ถาวร (เช่น Render free) ──────────
# ปล่อยว่างตามปกติ (ไม่ใช้งานฟีเจอร์นี้เลย) ดูวิธีตั้งค่าใน README หัวข้อ "ขึ้น Render ฟรี"

# เปิดใช้งาน — ใส่ "1" เท่านั้นถึงจะทำงาน
GIT_AUTOSYNC=

# ลิงก์ repo แบบ https (private repo เท่านั้น) เช่น https://github.com/<ชื่อคุณ>/genki-badminton.git
GIT_AUTOSYNC_REMOTE=

# GitHub Personal Access Token ที่มีสิทธิ์เขียน repo นี้ — ห้ามคอมมิตค่านี้ลง git เด็ดขาด
GIT_AUTOSYNC_TOKEN=

# สาขาที่จะดึง/บันทึกข้อมูล
GIT_AUTOSYNC_BRANCH=main
